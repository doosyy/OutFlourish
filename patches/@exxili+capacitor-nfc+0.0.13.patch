+    // MARK: - Formatting a blank NTAG21x
+
+    private func format(_ tag: NFCMiFareTag, session: NFCTagReaderSession) {
+        // GET_VERSION (0x60) tells us the vendor and storage size so we can
+        // write the correct Capability Container and confirm this really is an
+        // NXP NTAG before we touch its one-time-programmable CC page.
+        let getVersion = Data([0x60])
+        tag.sendMiFareCommand(commandPacket: getVersion) { (response, error) in
+            if let error = error {
+                session.invalidate(errorMessage: "This tag can't be formatted automatically.")
+                self.onError?(error)
+                return
+            }
+
+            // NTAG GET_VERSION response:
+            //   [0]=fixed 0x00, [1]=vendor (0x04 = NXP), [2]=product type
+            //   (0x04 = NTAG), [6]=storage size code.
+            guard response.count >= 7, response[1] == 0x04, response[2] == 0x04 else {
+                session.invalidate(errorMessage: "This tag needs to be formatted before use.")
+                return
+            }
+
+            // Storage size -> CC size byte (user memory / 8).
+            //   NTAG213 = 0x0F -> 0x12 (144 bytes)
+            //   NTAG215 = 0x11 -> 0x3E (504 bytes)
+            //   NTAG216 = 0x13 -> 0x6D (888 bytes)
+            let ccSize: UInt8
+            switch response[6] {
+            case 0x0F: ccSize = 0x12
+            case 0x11: ccSize = 0x3E
+            case 0x13: ccSize = 0x6D
+            default:
+                session.invalidate(errorMessage: "This tag needs to be formatted before use.")
+                return
+            }
+
+            // WRITE (0xA2) page 3 = Capability Container: E1 10 <size> 00
+            let ccCommand = Data([0xA2, 0x03, 0xE1, 0x10, ccSize, 0x00])
+            tag.sendMiFareCommand(commandPacket: ccCommand) { (_, error) in
+                if let error = error {
+                    session.invalidate(errorMessage: "Couldn't prepare the tag.")
+                    self.onError?(error)
+                    return
+                }
+
+                // WRITE (0xA2) page 4 = empty NDEF TLV: 03 00 FE 00
+                let tlvCommand = Data([0xA2, 0x04, 0x03, 0x00, 0xFE, 0x00])
+                tag.sendMiFareCommand(commandPacket: tlvCommand) { (_, error) in
+                    if let error = error {
+                        session.invalidate(errorMessage: "Couldn't prepare the tag.")
+                        self.onError?(error)
+                        return
+                    }
+
+                    // The tag is now NDEF-formatted; write the real message.
+                    tag.queryNDEFStatus { (status, _, _) in
+                        if status == .readWrite {
+                            self.write(to: tag, session: session)
+                        } else {
+                            // Some controllers report stale status immediately
+                            // after formatting; attempt the write regardless.
+                            self.write(to: tag, session: session)
+                        }
+                    }
+                }
+            }
+        }
